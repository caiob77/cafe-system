# Variáveis usadas pela stack docker-compose.prod.yml.
# Copiar para .env.production e preencher com valores reais.

# --- Domínio público ---------------------------------------------------------
DOMAIN=cafe.exemplo.com
LETSENCRYPT_EMAIL=voce@exemplo.com

# --- Postgres (host interno do compose: "postgres:5432") ---------------------
POSTGRES_USER=cafe
POSTGRES_PASSWORD=trocar-por-senha-forte
POSTGRES_DB=cafe

# --- API ---------------------------------------------------------------------
# Better Auth — gerar com: openssl rand -base64 48
DATABASE_ADMIN_URL=postgresql://cafe_admin:trocar-por-senha-forte-admin@postgres:5432/cafe?schema=public

# Senhas aplicadas por `pnpm -F @cafe/db db:roles` (rode após subir o postgres).
# DATABASE_URL da API deve usar a role cafe_runtime quando o RLS estiver ligado.
RUNTIME_DB_PASSWORD=trocar-por-senha-forte-runtime
ADMIN_DB_PASSWORD=trocar-por-senha-forte-admin
# Descomente para rodar a API como cafe_runtime (obrigatório com RLS ligado):
#DATABASE_URL=postgresql://cafe_runtime:trocar-por-senha-forte-runtime@postgres:5432/cafe?schema=public
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://cafe.exemplo.com
WEB_URL=https://cafe.exemplo.com

# Super admin do SaaS (emails separados por vírgula)
SUPER_ADMIN_EMAILS=
PRO_PLAN_PRICE=99

# Cloudinary (opcional, p/ uploads de imagem)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web ---------------------------------------------------------------------
# Em produção o front fala com a mesma origem (nginx faz proxy de /api/).
NEXT_PUBLIC_API_URL=https://cafe.exemplo.com
